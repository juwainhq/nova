{
  "name": "aria-voice-assistant",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && node scripts/rename-build-entry.mjs",
    "build:standalone": "node scripts/build-standalone.mjs",
    "verify:avatar": "node scripts/verify-avatar.mjs",
    "build:pages": "npm run build && npm run build:standalone && npm run verify:avatar && node scripts/sync-pages.mjs",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {}
}
